<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp"
    android:fitsSystemWindows="true">

    <include layout="@layout/component_topbar_friendlist" />

    <TextView
        android:id="@+id/daftarTeman"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="12dp"
        android:text="@string/label_friends_list"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:textSize="24sp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardFriendRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:backgroundTint="@color/light_purple">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <!-- Label -->
            <TextView
                android:id="@+id/textFriendRequest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_friend_requests"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp" />

            <!-- Badge jumlah request -->
            <TextView
                android:id="@+id/textRequestCount"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/circle_badge"
                android:gravity="center"
                android:elevation="4dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <!-- Icon next -->
            <ImageView
                android:id="@+id/iconNext"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_right"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Search bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white_bone"
            android:padding="2dp">

            <!-- Search Icon -->
            <ImageView
                android:id="@+id/iconSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_search"/>

            <!-- Input Field -->
            <EditText
                android:id="@+id/inputSearchFriend"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_toEndOf="@id/iconSearch"
                android:layout_toStartOf="@id/iconSendSearch"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:hint="@string/hint_search_friend_username"
                android:textSize="14sp"
                android:background="@color/white_bone"
                android:inputType="text" />

            <!-- Send Button -->
            <ImageView
                android:id="@+id/iconSendSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:src="@drawable/ic_send"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- ADD THIS RECYCLERVIEW FOR FRIEND LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp" />

</LinearLayout>