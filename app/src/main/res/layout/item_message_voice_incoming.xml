<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="60dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/voiceBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_incoming"
        android:padding="10dp"
        android:maxWidth="280dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPlayVoice"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_circle_black"
                android:padding="6dp"
                android:src="@drawable/ic_play"
                android:contentDescription="Play"/>

            <com.chattingapp.ui.chat.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvVoiceDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:text="00:00"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTranscriptAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transkrip"
            android:textColor="@color/blue"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/grey_time"
            android:layout_marginTop="2dp"/>
    </LinearLayout>


</LinearLayout>