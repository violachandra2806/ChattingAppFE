<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="60dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:gravity="end">

    <LinearLayout
        android:id="@+id/videoBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_outgoing"
        android:padding="10dp"
        android:maxWidth="280dp">

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="100dp">

            <ImageView
                android:id="@+id/ivVideoThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_video_thumbnail" />

            <ImageButton
                android:id="@+id/btnPlayVideo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_light_purple"
                android:padding="6dp"
                android:src="@drawable/ic_play"
                android:contentDescription="@string/cd_play_video" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvVideoDownloadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="gone"
            android:text="@string/label_downloading" />

        <ProgressBar
            android:id="@+id/progressVideoDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:progressTint="@color/white"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVideoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:text="@string/placeholder_duration" />

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textSize="11sp"
            android:textColor="@color/white"
            android:layout_marginTop="2dp"/>
    </LinearLayout>



</LinearLayout>