<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <include layout="@layout/component_topbar_addfriend" />

    <!-- Judul -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="12dp"
        android:text="Tambah Teman"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <com.google.android.material.card.MaterialCardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Search bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white_bone"
            android:padding="2dp">

            <!-- Search Icon -->
            <ImageView
                android:id="@+id/iconSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_search"/>

            <!-- Input Field -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputSearchUsername"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_toEndOf="@id/iconSearch"
                android:layout_toStartOf="@id/iconSendSearchUsername"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:hint="Ketik username..."
                android:textSize="14sp"
                android:background="@color/white_bone"
                android:inputType="text" />

            <!-- Send Button -->
            <ImageView
                android:id="@+id/iconSendSearchUsername"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:src="@drawable/ic_send"/>
        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Info hasil pencarian -->
    <TextView
        android:id="@+id/textSearchInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingTop="8dp"
        android:textColor="@android:color/darker_gray"
        android:visibility="gone"/>

    <!-- RecyclerView untuk hasil -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"/>
</LinearLayout>
