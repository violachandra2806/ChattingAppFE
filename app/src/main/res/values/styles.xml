<resources>

    <style name="Font_Poppins" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <style name="Font_Quicksand" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/quicksand_regular</item>
    </style>
    <style name="Font_Raleway" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/raleway_regular</item>
    </style>
    <style name="Font_Rubik" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/rubik_regular</item>
    </style>
    <style name="Font_Manrope" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/manrope_regular</item>
    </style>
    <style name="BottomNavText" parent="@style/TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:color">@color/light_purple</item>
    </style>
    <style name="PoppinsBoldTitle">
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>
    <style name="HintTextStyle">
        <item name="android:textStyle">italic</item>
    </style>
    <style name="CircleShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
        <item name="android:background">@color/light_purple</item>
    </style>
    <style name="AddFriendButtonStyle">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:backgroundTint">@color/light_purple</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawablePadding">6dp</item>
    </style>




</resources>
