<resources>

    <style name="Font_Poppins" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <style name="Font_Quicksand" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/quicksand_regular</item>
    </style>
    <style name="Font_Raleway" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/raleway_regular</item>
    </style>
    <style name="Font_Rubik" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/rubik_regular</item>
    </style>
    <style name="Font_Manrope" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/manrope_regular</item>
    </style>
    <style name="PoppinsBoldTitle">
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>
    <style name="HintTextStyle">
        <item name="android:textStyle">italic</item>
    </style>
    <style name="AddFriendButtonStyle">
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/bg_pill_add_friend</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <!-- Splash Screen Theme -->
    <style name="Theme.ChattingApp.Splash" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/light_purple</item>
        <item name="android:navigationBarColor">@color/light_purple</item>
    </style>




</resources>
