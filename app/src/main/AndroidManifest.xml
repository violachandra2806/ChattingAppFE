<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.chattingapp">

    <!-- ✅ Required for internet/network access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChattingApp"
        tools:targetApi="31"
        android:usesCleartextTraffic="true">

        <!-- Splash Screen Activity (New Main Entry Point) -->
        <activity
            android:name=".ui.startapp.SplashScreen"
            android:exported="true"
            android:theme="@style/Theme.ChattingApp" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- StartApp Activity (Welcome Screen with Login/Register buttons) -->
        <activity
            android:name=".ui.startapp.StartAppActivity"
            android:exported="false"
            android:theme="@style/Theme.ChattingApp" />

        <!-- Login Activity -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register Activity -->
        <activity
            android:name=".ui.register.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Forgot Password Activity -->
        <activity
            android:name=".ui.forgotpassword.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Dashboard Activity (Hosts Fragments) - Main app after login -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.ChattingApp" />

        <!-- Chat Room Activity -->
        <activity
            android:name=".ui.chat.ChatRoomActivity"
            android:exported="false"
            android:theme="@style/Theme.ChattingApp" />

        <!-- Friend Request Activity -->
        <activity
            android:name=".ui.friendlist.friendrequest.FriendRequestActivity"
            android:exported="false"/>

        <!-- Add Friend Activity -->
        <activity
            android:name=".ui.friendlist.addfriend.AddFriendActivity"
            android:exported="false"/>

    </application>
</manifest>
